Unicode True
Name "Speediance FIT Exporter 0.1.36-beta"
OutFile "dist\SpeedianceFITExporter-Setup.exe"
VIProductVersion "0.1.36.0"
VIAddVersionKey "ProductName" "Speediance FIT Exporter"
VIAddVersionKey "FileDescription" "Speediance FIT Exporter Beta Installer"
VIAddVersionKey "ProductVersion" "0.1.36-beta"
InstallDir "$LOCALAPPDATA\Programs\Speediance FIT Exporter"
RequestExecutionLevel user
Page directory
Page instfiles
UninstPage uninstConfirm
UninstPage instfiles
Section "Install"
 SetOutPath "$INSTDIR"
 File "dist\SpeedianceFITExporter.exe"
 File "README.md"
 File "CHANGELOG.md"
 ; Remove single-language documents left from RC.1 during upgrade.
 Delete "$INSTDIR\docs\Benutzerhandbuch.md"
 Delete "$INSTDIR\docs\Quick_Start_EN.md"
 Delete "$INSTDIR\docs\Bekannte_Einschraenkungen.md"
 Delete "$INSTDIR\docs\Drittquellen.md"
 Delete "$SMPROGRAMS\Speediance FIT Exporter\Benutzerhandbuch.lnk"
 Delete "$SMPROGRAMS\Speediance FIT Exporter\Quick Start (English).lnk"
 SetOutPath "$INSTDIR\docs\de"
 File "docs\de\README.md"
 File "docs\de\quick-start.md"
 File "docs\de\user-guide.md"
 File "docs\de\known-limitations.md"
 File "docs\de\changelog.md"
 File "docs\de\development.md"
 File "docs\de\rc-checklist.md"
 File "docs\de\third-party.md"
 File "docs\de\publication-checklist.md"
 SetOutPath "$INSTDIR\docs\en"
 File "docs\en\README.md"
 File "docs\en\quick-start.md"
 File "docs\en\user-guide.md"
 File "docs\en\known-limitations.md"
 File "docs\en\changelog.md"
 File "docs\en\development.md"
 File "docs\en\rc-checklist.md"
 File "docs\en\third-party.md"
 File "docs\en\publication-checklist.md"
 SetOutPath "$INSTDIR"
 WriteUninstaller "$INSTDIR\Uninstall.exe"
 CreateDirectory "$SMPROGRAMS\Speediance FIT Exporter"
 CreateShortCut "$SMPROGRAMS\Speediance FIT Exporter\Speediance FIT Exporter.lnk" "$INSTDIR\SpeedianceFITExporter.exe"
 CreateShortCut "$SMPROGRAMS\Speediance FIT Exporter\Benutzerhandbuch (Deutsch).lnk" "$WINDIR\notepad.exe" '$\"$INSTDIR\docs\de\user-guide.md$\"'
 CreateShortCut "$SMPROGRAMS\Speediance FIT Exporter\User Manual (English).lnk" "$WINDIR\notepad.exe" '$\"$INSTDIR\docs\en\user-guide.md$\"'
 CreateShortCut "$SMPROGRAMS\Speediance FIT Exporter\Deinstallieren.lnk" "$INSTDIR\Uninstall.exe"
SectionEnd
Section "Uninstall"
 Delete "$INSTDIR\SpeedianceFITExporter.exe"
 Delete "$INSTDIR\README.md"
 Delete "$INSTDIR\CHANGELOG.md"
 Delete "$INSTDIR\docs\de\README.md"
 Delete "$INSTDIR\docs\de\quick-start.md"
 Delete "$INSTDIR\docs\de\user-guide.md"
 Delete "$INSTDIR\docs\de\known-limitations.md"
 Delete "$INSTDIR\docs\de\changelog.md"
 Delete "$INSTDIR\docs\de\development.md"
 Delete "$INSTDIR\docs\de\rc-checklist.md"
 Delete "$INSTDIR\docs\de\third-party.md"
 Delete "$INSTDIR\docs\de\publication-checklist.md"
 RMDir "$INSTDIR\docs\de"
 Delete "$INSTDIR\docs\en\README.md"
 Delete "$INSTDIR\docs\en\quick-start.md"
 Delete "$INSTDIR\docs\en\user-guide.md"
 Delete "$INSTDIR\docs\en\known-limitations.md"
 Delete "$INSTDIR\docs\en\changelog.md"
 Delete "$INSTDIR\docs\en\development.md"
 Delete "$INSTDIR\docs\en\rc-checklist.md"
 Delete "$INSTDIR\docs\en\third-party.md"
 Delete "$INSTDIR\docs\en\publication-checklist.md"
 RMDir "$INSTDIR\docs\en"
 Delete "$INSTDIR\docs\Benutzerhandbuch.md"
 Delete "$INSTDIR\docs\Quick_Start_EN.md"
 Delete "$INSTDIR\docs\Bekannte_Einschraenkungen.md"
 Delete "$INSTDIR\docs\Drittquellen.md"
 RMDir "$INSTDIR\docs"
 Delete "$INSTDIR\Uninstall.exe"
 RMDir "$INSTDIR"
 RMDir /r "$SMPROGRAMS\Speediance FIT Exporter"
 ; Do not delete users' settings, cached exercise/health data, FIT exports
 ; or optional Windows Credential Manager entries during uninstallation.
SectionEnd
